# Salin file ini menjadi `backend/.env` lalu isi kredensial SMTP Anda.
# Kalau file .env tidak ada / belum diisi, backend jalan dalam DEV MODE:
# kode verifikasi hanya dicetak di terminal server (email tidak dikirim).

# --- Gmail (wajib pakai App Password 16 karakter, bukan password akun) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailanda@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM_EMAIL=emailanda@gmail.com
SMTP_FROM_NAME=FoodScan AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Alternatif: SMTP port 465 (SSL langsung) ---
# SMTP_PORT=465
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true
